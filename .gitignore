# Données : ni copie locale des sources ni base DuckDB persistante (le pipeline lit les sources à distance)
*.duckdb
*.duckdb.wal
*.parquet

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / build
node_modules/
dist/

# Environnement & IDE
.env
.env.*
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# Données générées par les prototypes
spikes/*/data/

# Fichiers produits par le pipeline
publication/
.pytest_cache/

# Référentiels versionnés : exception à la règle *.parquet
!referentiels/*.parquet
